# Copy this file to ".env" and fill in real values. ".env" is git-ignored.

# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=your-typesafe-api-key-here

# Login for the web page and the API. There are no defaults: the app will not start without them.
# Use a long random password (at least 12 characters), for example: python -c "import secrets; print(secrets.token_urlsafe(18))"
APP_USERNAME=choose-a-username
APP_PASSWORD=choose-a-long-random-password

# Deployment only (see README "Deploying securely"):
# COOKIE_SECURE=true
# FORWARD_HEADERS_STRATEGY=native
